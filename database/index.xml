&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="text-align: left"&gt;1001&lt;/td&gt;
&lt;td style="text-align: left"&gt;김하늘&lt;/td&gt;
&lt;td style="text-align: left"&gt;수학, 영어&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
